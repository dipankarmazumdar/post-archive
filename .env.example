# Public site origin used for canonical URLs, the sitemap, and the RSS feed.
# No trailing slash. Not a secret.
SITE_URL=http://localhost:3000

# Optional. Comma-separated emails allowed to use the admin editor.
# When unset, any signed-in person who can open the app may edit.
# Local development uses a simulated viewer (dev@example.com) unless this is set.
EDITOR_EMAILS=

# Optional. Postgres connection for a deployed database.
# When unset, the app stores editorial data in data/pglite (gitignored).
# The host sets DATABASE_URL when this app is published with its database.
# Never commit a real value. If your shell already has DATABASE_URL pointed
# at some other database, run local commands with it unset:
#   env -u DATABASE_URL npm run dev
# DATABASE_URL=

# Optional. Direct Postgres connection for migrations when DATABASE_URL is pooled.
# DATABASE_URL_UNPOOLED=

# Optional. Override the local PGlite directory.
# ARCHIVE_DATA_DIR=data/pglite
